{
  "name": "@zemd/eslint-rock-stack",
  "version": "3.1.1",
  "description": "Shared ESLint config for modern projects",
  "keywords": [
    "eslint",
    "eslint rules",
    "eslint-config",
    "eslint-flat-config",
    "eslintconfig",
    "flat config",
    "javascript",
    "react",
    "tailwindcss",
    "typescript"
  ],
  "homepage": "https://eslint-config.zemd.dev/",
  "bugs": {
    "url": "https://github.com/zemd/js-tooling/issues"
  },
  "license": "Apache-2.0",
  "author": {
    "name": "Dmytro Zelenetskyi",
    "email": "oss@zemd.dev",
    "url": "https://zemd.dev"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zemd/js-tooling.git",
    "directory": "eslint/rock-stack"
  },
  "funding": "https://github.com/sponsors/zemd",
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./tailwind": {
      "types": "./dist/tailwind.d.mts",
      "import": "./dist/tailwind.mjs"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "provenance": true
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "lint-publish": "publint",
    "test": "node --test",
    "test-coverage": "node --test --experimental-test-coverage \"--test-coverage-include=src/**/*.ts\" \"--test-coverage-exclude=src/**/*.test.ts\" --test-reporter=spec --test-reporter=lcov --test-reporter-destination=stdout --test-reporter-destination=coverage.lcov",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@graphql-eslint/eslint-plugin": "4.4.1",
    "@vitest/eslint-plugin": "1.6.27",
    "@zemd/eslint-common": "workspace:*",
    "@zemd/eslint-react": "workspace:*",
    "eslint-plugin-playwright": "2.11.0",
    "eslint-plugin-storybook": "10.5.8",
    "eslint-plugin-turbo": "2.10.10"
  },
  "devDependencies": {
    "@types/eslint": "catalog:",
    "@types/node": "catalog:",
    "@zemd/tsconfig": "catalog:",
    "eslint": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:eslint"
  },
  "peerDependencies": {
    "eslint": ">=9.2.0 || >=10.0.0",
    "eslint-plugin-tailwindcss": "3.18.0",
    "storybook": "^10.5.3"
  },
  "peerDependenciesMeta": {
    "eslint-plugin-tailwindcss": {
      "optional": true
    },
    "storybook": {
      "optional": true
    }
  }
}
