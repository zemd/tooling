{
  "name": "@zemd/eslint-ts",
  "version": "3.1.2",
  "description": "Shared ESLint config for TypeScript projects",
  "keywords": [
    "eslint",
    "eslint rules",
    "eslint-config",
    "eslint-flat-config",
    "eslintconfig",
    "flat config",
    "javascript",
    "typescript"
  ],
  "homepage": "https://eslint-config.zemd.dev/",
  "bugs": {
    "url": "https://github.com/zemd/tooling/issues"
  },
  "license": "Apache-2.0",
  "author": {
    "name": "Dmytro Zelenetskyi",
    "email": "oss@zemd.dev",
    "url": "https://zemd.dev"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zemd/tooling.git",
    "directory": "eslint/ts"
  },
  "funding": "https://github.com/sponsors/zemd",
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "provenance": true
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "lint-publish": "publint",
    "test": "node --test",
    "test-coverage": "node --test --experimental-test-coverage \"--test-coverage-include=src/**/*.ts\" \"--test-coverage-exclude=src/**/*.test.ts\" --test-reporter=spec --test-reporter=lcov --test-reporter-destination=stdout --test-reporter-destination=coverage.lcov",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@typescript-eslint/eslint-plugin": "8.68.0",
    "@typescript-eslint/parser": "8.68.0",
    "@zemd/eslint-common": "workspace:*",
    "@zemd/eslint-js": "workspace:*"
  },
  "devDependencies": {
    "@types/eslint": "catalog:",
    "@types/node": "catalog:",
    "@zemd/tsconfig": "catalog:",
    "eslint": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:eslint"
  },
  "peerDependencies": {
    "eslint": ">=9.2.0 || >=10.0.0"
  }
}
