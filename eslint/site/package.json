{
  "name": "@zemd/eslint-site",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "eslint-config-inspector build --config ./eslint.config.mjs --outDir ./dist/__eslint-config-inspector --base /",
    "dev": "eslint-config-inspector --config ./eslint.config.mjs --base /",
    "deploy": "wrangler deploy"
  },
  "dependencies": {
    "@zemd/eslint-astro": "workspace:*",
    "@zemd/eslint-next": "workspace:*"
  },
  "devDependencies": {
    "@eslint/config-inspector": "3.2.0",
    "typescript": "catalog:eslint",
    "wrangler": "4.123.0"
  }
}
